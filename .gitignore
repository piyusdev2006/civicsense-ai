# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ──────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js Build Output ──────────────────────────────────────────
/.next/
/out/
/build

# ── Environment & Secrets ─────────────────────────────────────────
.env*

# ── AWS Setup & Test Scripts (local dev only) ─────────────────────
aws_setup.mjs
run_tests.mjs
test_bedrock.mjs

# ── TypeScript Generated ──────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Debug Logs ────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/coverage

# ── OS & Editor ───────────────────────────────────────────────────
.DS_Store
*.pem
Thumbs.db
.vscode/
.idea/

# ── Deployment Platform ───────────────────────────────────────────
.vercel
.amplify/

# ── Default Next.js Placeholder Assets (not needed) ───────────────
public/file.svg
public/globe.svg
public/next.svg
public/vercel.svg
public/window.svg

# ── Local Documentation (personal use only, not for GitHub) ───────
ARCHITECTURE.md
DEPLOYMENT.md
FLOW_DIAGRAM.md
TEST_CASES.md
MEDIUM_FINAL.md
docs-local/
project_report.md
